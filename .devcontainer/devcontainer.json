{
  "name": "GreenLoop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install -e 'packages/contracts[dev]' -e 'services/orchestrator[dev]' -e 'services/broker[dev]' -e 'services/self-improvement[dev]' && npm --prefix apps/web ci",
  "forwardPorts": [8000, 8100, 3000, 5432],
  "portsAttributes": {
    "8000": { "label": "orchestrator" },
    "8100": { "label": "broker" },
    "3000": { "label": "web" },
    "5432": { "label": "postgres" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "hashicorp.terraform",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
