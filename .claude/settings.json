{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(gh:*)",
      "Bash(gh)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)",
      "Bash(cat .env:*)",
      "PowerShell(git push *)",
      "PowerShell(git push)",
      "PowerShell(gh *)",
      "PowerShell(gh)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker system prune *)",
      "PowerShell(Get-Content *.env*)",
      "Read(.env)",
      "Read(/.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(~/AppData/Local/GreenLoop/**)",
      "Edit(.env)",
      "Edit(/.env)",
      "Edit(~/AppData/Local/GreenLoop/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(docker run:*)",
      "Bash(docker rm:*)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git rebase *)",
      "PowerShell(git merge *)",
      "PowerShell(pip install *)",
      "PowerShell(npm install *)",
      "PowerShell(docker run *)",
      "PowerShell(docker rm *)",
      "WebFetch"
    ]
  }
}
